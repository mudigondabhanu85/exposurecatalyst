# ExposureCatalyst configuration. Full reference: docs/reference/configuration.md
# NEVER commit .env. In AWS, inject secrets from Secrets Manager into the ECS task definition.

EXCAT_ENV=prod                        # prod | dev | test (dev allows SQLite and insecure cookies)
EXCAT_PUBLIC_URL=http://localhost:8000
EXCAT_LOG_JSON=true

# docker-compose builds EXCAT_DATABASE_URL from this password:
POSTGRES_PASSWORD=
# Outside compose, set the URL directly, e.g.:
# EXCAT_DATABASE_URL=postgresql+psycopg://excat:***@db.example.internal:5432/excat?sslmode=verify-full

# Fernet key for secrets at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EXCAT_ENCRYPTION_KEY=

# Browsers treat http://localhost as a secure context, so Secure cookies work locally.
# If yours does not, use EXCAT_ENV=dev and EXCAT_COOKIE_SECURE=false for local testing only.
EXCAT_COOKIE_SECURE=true

# Optional: NVD API key raises the rate limit 10x (https://nvd.nist.gov/developers/request-an-api-key)
EXCAT_NVD_API_KEY=

EXCAT_FETCH_INTERVAL_MINUTES=60
EXCAT_INITIAL_BACKFILL_DAYS=7
EXCAT_SCHEDULER_EMBEDDED=false        # true = run scheduler inside the API process (dev only)
