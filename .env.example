# ExposureCatalyst configuration. Full reference: docs/reference/configuration.md
# NEVER commit .env. In AWS, inject secrets from Secrets Manager into the ECS task definition.

EXCAT_ENV=prod                        # prod | dev | test (dev allows SQLite and insecure cookies)
EXCAT_PUBLIC_URL=http://localhost:8000
EXCAT_LOG_JSON=true

# docker-compose builds EXCAT_DATABASE_URL from this password:
POSTGRES_PASSWORD=
# Outside compose, set the URL directly, e.g.:
# EXCAT_DATABASE_URL=postgresql+psycopg://excat:***@db.example.internal:5432/excat?sslmode=verify-full

# Fernet key for secrets at rest. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EXCAT_ENCRYPTION_KEY=

# Browsers treat http://localhost as a secure context, so Secure cookies work locally.
# If yours does not, use EXCAT_ENV=dev and EXCAT_COOKIE_SECURE=false for local testing only.
EXCAT_COOKIE_SECURE=true

# Optional: NVD API key raises the rate limit 10x (https://nvd.nist.gov/developers/request-an-api-key)
EXCAT_NVD_API_KEY=

EXCAT_FETCH_INTERVAL_MINUTES=60
EXCAT_INITIAL_BACKFILL_DAYS=7
EXCAT_SCHEDULER_EMBEDDED=false        # true = run scheduler inside the API process (dev only)

# ==== Docker deployment (docker compose up -d) — all optional; defaults shown ===============================
# Secrets: leave EXCAT_ENCRYPTION_KEY and POSTGRES_PASSWORD empty and the `init` container generates them into
# the `secrets` / `db-secret` volumes (never overwritten). Values set here always take precedence.
# EXCAT_FQDN=localhost                 # hostname users browse to (or `fqdn:` in config/exposurecatalyst.yaml);
#                                      # the public URL becomes https://<fqdn>[:EXCAT_HTTPS_PORT]
# EXCAT_HTTP_PORT=80
# EXCAT_HTTPS_PORT=443
# EXCAT_HTTPS_PORT_SUFFIX=             # set to ":8443" when EXCAT_HTTPS_PORT is not 443 (HTTP→HTTPS redirect)
# EXCAT_BIND_ADDRESS=0.0.0.0           # 127.0.0.1 to listen on loopback only
# EXCAT_WEB_CONCURRENCY=1              # API worker processes (login rate limits are per process)
# EXCAT_EDGE_SUBNET=172.30.250.0/24    # proxy↔api network; also the trusted X-Forwarded-For range
# EXCAT_PROXY_IP=172.30.250.10         # must be inside EXCAT_EDGE_SUBNET
# EXCAT_TRUSTED_PROXIES=private_ranges # load balancers in front of the proxy whose X-Forwarded-* are trusted
# EXCAT_IMAGE_TAG=local
# Corporate outbound proxy for api / scheduler / worker (CVE sources, integrations, AI vendors):
# HTTP_PROXY=http://proxy.corp.example:3128
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1,postgres,redis,api,proxy,ollama
# External database instead of the bundled PostgreSQL:
# COMPOSE_FILE=docker-compose.yml:docker/compose.external-db.yml
# EXCAT_DATABASE_URL=postgresql+psycopg://excat:***@db.example.internal:5432/excat?sslmode=verify-full
# Profiles: COMPOSE_PROFILES=backup   (scale, backup, ollama, direct, devmail — comma-separated)
# EXCAT_BACKUP_INTERVAL_HOURS=24
# EXCAT_BACKUP_RETENTION_DAYS=14
# EXCAT_WORKER_REPLICAS=1
# EXCAT_DIRECT_PORT=8000               # --profile direct: plain HTTP on 127.0.0.1 (pre-1.4 behaviour)
# EXCAT_DOCKERHUB_MIRROR=docker.io     # e.g. mirror.gcr.io or registry.corp.example/dockerhub (images stay digest-pinned)
