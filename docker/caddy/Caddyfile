# ExposureCatalyst reverse proxy (Docker deployment). The only service with published ports.
#
# * Listens on 8080/8443 inside the container (published as EXCAT_HTTP_PORT/EXCAT_HTTPS_PORT, default 80/443),
#   so it runs as non-root with ALL capabilities dropped: no NET_BIND_SERVICE needed.
# * Certificate: certs volume (active/fullchain.pem + privkey.pem), written by the init container (self-signed)
#   or by Settings → Certificates & Domain. Reloads are triggered through the admin API, which listens only on a
#   unix socket in a volume shared with the api container — never on TCP, never via the Docker socket.
# * Everything except the hashed SPA assets is proxied to the API, so authentication on /docs, security headers
#   (CSP, HSTS, …) and SPA rendering stay exactly as in the API.
{
	admin unix//run/caddy-admin/admin.sock|0660
	auto_https off
	servers {
		protocols h1 h2
		trusted_proxies static {$EXCAT_TRUSTED_PROXIES:private_ranges}
	}
	log {
		output stdout
		format json
	}
}

http://:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		redir https://{host}{$EXCAT_HTTPS_PORT_SUFFIX}{uri} 308
	}
}

https://:8443 {
	tls /certs/active/fullchain.pem /certs/active/privkey.pem {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	request_body {
		max_size 60MB
	}

	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy api:8000 {
			health_uri /api/health/live
			health_interval 15s
		}
	}
}
