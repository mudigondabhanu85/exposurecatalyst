{#- Code-owned, Outlook-safe layout: table-based, inline styles, no CSS classes, no SVG.
    logo_src = "cid:excat-logo" (SMTP / .eml) or a base64 data URI (copy, HTML, PDF). -#}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#F7F8FA;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F7F8FA;border-collapse:collapse;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:640px;max-width:640px;background-color:#FFFFFF;border:1px solid #D5DBE4;border-collapse:collapse;">
{%- if watermark %}
<tr><td style="padding:8px 28px;background-color:#FFF4CC;border-bottom:1px solid #C9A200;font-family:Inter,Arial,Helvetica,sans-serif;font-size:12px;font-weight:bold;color:#5C4200;">{{ watermark }}</td></tr>
{%- endif %}
<tr><td style="padding:20px 28px 16px 28px;background-color:#FFFFFF;border-bottom:4px solid #E8541A;">
<img src="{{ logo_src }}" width="211" height="40" alt="ExposureCatalyst" style="display:block;border:0;outline:none;text-decoration:none;width:211px;height:40px;" />
</td></tr>
<tr><td style="padding:10px 28px;background-color:{{ sev.bg }};font-family:Inter,Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;letter-spacing:1px;color:{{ sev.fg }};">
{{ advisory.severity }} SECURITY ADVISORY&nbsp;&nbsp;·&nbsp;&nbsp;{{ advisory.advisory_id }}
</td></tr>
<tr><td style="padding:24px 28px 8px 28px;font-family:Inter,Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#0B1B33;">
<h1 style="margin:0 0 6px 0;font-family:'Space Grotesk',Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;font-weight:bold;color:#0B1B33;">{{ advisory.cve_id }}{% if advisory.title %} – {{ advisory.title }}{% endif %}</h1>
{{ body }}
{%- if intel is defined and intel %}
<h2 style="margin:20px 0 8px 0;font-family:'Space Grotesk',Arial,Helvetica,sans-serif;font-size:16px;line-height:22px;font-weight:bold;color:#0B1B33;">Threat intelligence (licensed sources)</h2>
{%- for i in intel %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 10px 0;">
<tr><td style="padding:8px 10px;border:1px solid #D5DBE4;font-family:Inter,Arial,Helvetica,sans-serif;font-size:13px;line-height:19px;color:#0B1B33;">
<span style="font-size:11px;color:#4A5568;">{{ i.source }} · TLP:{{ i.tlp }}{% if i.published %} · {{ i.published }}{% endif %}{% if i.exploited %} · <strong style="color:#9B1C1C;">exploited</strong>{% endif %}</span><br />
<strong>{{ i.title }}</strong>{% if i.summary %}<br />{{ i.summary }}{% endif %}{% if i.description %}<br /><span style="color:#4A5568;">{{ i.description }}</span>{% endif %}{% if i.url %}<br /><a href="{{ i.url }}" style="color:#0B1B33;">{{ i.url }}</a>{% endif %}
</td></tr></table>
{%- endfor %}
{%- endif %}
</td></tr>
<tr><td style="padding:16px 28px;background-color:#EEF1F5;border-top:1px solid #D5DBE4;font-family:Inter,Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#4A5568;">
Generated by ExposureCatalyst&nbsp;·&nbsp;Advisory ID <strong style="color:#0B1B33;">{{ advisory.advisory_id }}</strong>&nbsp;·&nbsp;{{ generated_at }}<br />
Please quote <strong style="color:#0B1B33;">{{ advisory.advisory_id }}</strong> in tickets and replies.
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
